---
import siteConfig from '../data/site-config';
import CustomImage from './CustomImage.astro';

const titleClass = 'text-theme-foreground font-serif text-2xl leading-tight font-medium sm:text-3xl';
const homeHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<header class="mx-auto mb-12 flex w-full max-w-3xl items-center gap-4 sm:mb-16">
    {
        siteConfig.avatar?.src && (
            <a href={homeHref} class="flex aspect-square w-16 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white p-0.5 sm:w-20 sm:p-1">
                <CustomImage
                    class="h-full w-full object-contain"
                    {...siteConfig.avatar}
                    loading="eager"
                    fetchpriority="high"
                    width={80}
                    height={80}
                    widths={[80, 160]}
                    sizes="80px"
                />
            </a>
        )
    }
    <div class="grow">
        {
            siteConfig.avatar?.src ? (
                <h1 class={titleClass}>{siteConfig.title}</h1>
            ) : (
                <h1 class={titleClass}>
                    <a href={homeHref}>{siteConfig.title}</a>
                </h1>
            )
        }
        {siteConfig.subtitle && <p class="text-sm leading-tight">{siteConfig.subtitle}</p>}
    </div>
</header>
