---
import { Image, type ImageMetadata } from 'astro:assets';
import gathering2025 from '../assets/images/events/BWW_2025.jpg';
import gathering2026 from '../assets/images/events/BWW_2026.jpg';
import Button from './Button.astro';

type GalleryImage = {
    src: ImageMetadata;
    alt: string;
    caption: string;
    year: string;
    credit: string;
};

const images: GalleryImage[] = [
    {
        src: gathering2025,
        alt: 'Badass Women in Wine Leadership Gathering in 2025',
        caption: 'Badass Women in Wine Leadership Gathering',
        year: '2025',
        credit: 'Photo by Janeth Sanchez'
    },
    {
        src: gathering2026,
        alt: 'Badass Women in Wine Leadership Gathering in 2026',
        caption: 'Badass Women in Wine Leadership Gathering',
        year: '2026',
        credit: 'Photo by Janeth Sanchez'
    }
];
---

<section class="not-prose mt-16 sm:mt-24" aria-labelledby="gallery-title">
    <h2 id="gallery-title" class="font-serif text-3xl font-medium sm:text-4xl">Gallery</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
            images.map(({ src, alt, caption, year, credit }) => (
                <figure>
                    <Image
                        src={src}
                        alt={alt}
                        class="aspect-3/2 w-full object-cover"
                        widths={[480, 768, 1200]}
                        sizes="(min-width: 640px) 352px, calc(100vw - 32px)"
                    />
                    <figcaption class="text-main/60 mt-2 text-xs">
                        <strong class="font-medium">{caption}</strong> <em>{year}</em>
                        <span class="mt-1 block">{credit}</span>
                    </figcaption>
                </figure>
            ))
        }
    </div>
    <div class="border-main/25 mt-10 border-t pt-8">
        <p class="text-sm leading-relaxed sm:text-base">See more gatherings and community moments on Instagram.</p>
        <Button href="https://www.instagram.com/badasswomeninwine/" target="_blank" rel="noreferrer" class="mt-5"> Instagram · @badasswomeninwine </Button>
    </div>
</section>
